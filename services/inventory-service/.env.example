# Copy this file to ".env" and fill in the real values.
# ".env" is git-ignored so your real MongoDB password never gets committed.

# Port this service listens on (from the bootcamp spec: inventory-service = 4005)
PORT=4005

# MongoDB connection string.
# Local Mongo:   mongodb://127.0.0.1:27017/inventory-db
# Mongo Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/inventory-db
MONGO_URI=mongodb://127.0.0.1:27017/inventory-db
