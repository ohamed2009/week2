# Copy this file to ".env" and fill in the real values.
# ".env" is git-ignored so your real MongoDB password never gets committed.

# Port this service listens on (from the bootcamp spec: notification-service = 4006)
PORT=4006

# MongoDB connection string.
# Local Mongo:   mongodb://127.0.0.1:27017/notification-db
# Mongo Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/notification-db
MONGO_URI=mongodb://127.0.0.1:27017/notification-db

# RabbitMQ: notification-service consumes "order.confirmed" events published
# by order-service on this exchange, via its own durable queue.
RABBITMQ_URL=amqp://localhost
RABBITMQ_EXCHANGE=order-events
RABBITMQ_QUEUE=notification-service-order-confirmed
